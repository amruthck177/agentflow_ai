# ==============================================================================
# Agentflow_AI — Environment Variables Configuration Template
# ==============================================================================

# ─── Server Configuration ─────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── MongoDB (Local, Docker, or Atlas) ─────────────────────────────────────────
# Local: mongodb://localhost:27017/agentflow_ai
# Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/agentflow_ai?retryWrites=true&w=majority
# Leave blank to use the built-in in-memory MongoDB fallback
MONGODB_URI=mongodb://localhost:27017/agentflow_ai

# ─── JWT Authentication ───────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# ─── Redis (BullMQ Queues) ────────────────────────────────────────────────────
# Redis connection URI for BullMQ background execution queues & backoff retries.
# Leave blank to use the built-in in-memory queue fallback
REDIS_URL=redis://localhost:6379

# ─── Credential Encryption (AES-256) ──────────────────────────────────────────
# 32-byte hex key for encrypting OAuth tokens and secrets at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIAL_ENCRYPTION_KEY=01234567890123456789012345678901

# ─── CORS & Client URL ────────────────────────────────────────────────────────
CLIENT_URL=http://localhost:3000

# ─── AI Providers (Optional — Fallback to Deterministic Builder) ──────────────
# Primary AI provider for natural language prompt synthesis
OPENROUTER_API_KEY=

# Fallback AI provider
GEMINI_API_KEY=

# ─── OAuth: Google (Gmail & Google Sheets) ────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/integrations/oauth/gmail/callback

# ─── OAuth: Slack ─────────────────────────────────────────────────────────────
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:5000/api/integrations/oauth/slack/callback

# ─── OAuth: Discord ───────────────────────────────────────────────────────────
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_REDIRECT_URI=http://localhost:5000/api/integrations/oauth/discord/callback

# ─── Frontend Next.js Public Variables (client/.env.local) ────────────────────
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000
